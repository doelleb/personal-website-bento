---
import type { Entry } from "../../data/cv";

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<ol class="flex flex-col gap-4 list-none p-0 m-0">
  {
    entries.map((e) => (
      <li class="bg-darkslate-500 border border-darkslate-400 rounded-lg p-5">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h3 class="text-lg font-bold m-0">{e.title}</h3>
          <span class="text-3xs text-darkslate-300 whitespace-nowrap tabular-nums">
            {e.date}
          </span>
        </div>
        <p class="text-sm text-primary-400 m-0 mt-0.5">
          {e.org}
          {e.place && <span class="text-darkslate-300"> · {e.place}</span>}
        </p>
        {e.bullets && (
          <ul class="mt-3 pl-4 flex flex-col gap-1.5 list-disc text-sm text-darkslate-100 marker:text-darkslate-300">
            {e.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>
