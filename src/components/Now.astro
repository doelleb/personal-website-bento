---
import Card from "./Card/index.astro";
import Pulse from "./Pulse.astro";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  padding="py-3 px-6"
  nsPadY="0.75rem"
  centerY
>
  <div class="flex flex-col gap-1">
    <div class="flex justify-between items-center w-full">
      <div class="flex items-baseline gap-2">
        <h2 class="text-white text-lg font-bold">Now</h2>
        <a
          href="https://sive.rs/nowff"
          target="_blank"
          class="text-3xs text-darkslate-300 hover:text-darkslate-100 transition-colors"
        >
          what's this?
        </a>
      </div>
      <div class="flex items-center gap-1.5">
        <time class="text-3xs text-darkslate-300" datetime="2026-11-05"
          >Nov 5, 2026</time
        >
        <Pulse />
      </div>
    </div>
    <p class="text-xs whitespace-nowrap overflow-hidden text-ellipsis">
      Prepping two NeurIPS 2026 talks
    </p>
  </div>
</Card>
