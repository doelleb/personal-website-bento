---
import { withBase } from "../lib/base";

interface Props {
  href?: string;
  class?: string;
  label?: string;
}

const {
  href = "/playground",
  class: extraClass = "",
  label = "Back",
} = Astro.props;
---

<span class:list={["btn-shell btn-shell--flat inline-flex w-fit", extraClass]}>
  <a
    href={withBase(href)}
    class="btn--ns btn-chrome inline-flex items-center w-fit px-4 py-2 rounded-lg"
  >
    {label}
  </a>
</span>
