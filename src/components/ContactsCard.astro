---
import Card from "./Card/index.astro";
import { SITE } from "../site-config";

const linkClass =
  "inline-block w-fit text-darkslate-100 hover:text-primary-400 hover:translate-x-0.5 transition-all duration-150";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4" class="pad-lg">
  <div class="h-full">
    <header class="flex items-center">
      <h2 class="text-white text-xl font-bold">Let's connect!</h2>
    </header>
    <p class="text-sm text-darkslate-100 mt-2">
      Open to research collaborations, speaking, and summer opportunities in AI
      safety, policy, and finance.
    </p>
    <address class="flex flex-col mt-4 not-italic">
      <h2 class="text-darkslate-300">Contact Details</h2>
      <a
        href={`mailto:${SITE.links.email}`}
        class={`text-sm break-all ${linkClass}`}>{SITE.links.email}</a
      >
      <p>{SITE.location.city}</p>
    </address>
    <div class="flex flex-col mt-4 w-fit">
      <h2 class="text-darkslate-300">Find me on</h2>
      <ul>
        <li>
          <a href={SITE.links.linkedin} target="_blank" class={linkClass}
            >LinkedIn</a
          >
        </li>
      </ul>
    </div>
  </div>
</Card>
