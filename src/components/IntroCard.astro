---
import Card from "./Card/index.astro";
import Button from "./Button.astro";
import { Icon } from "astro-icon/components";
import Tooltip from "./Tooltip/index";
import { SITE } from "../site-config";
import NeuralOrb from "./NeuralOrb.astro";
---

<Card colSpan="md:col-span-3" rowSpan="md:row-span-4" class="pad-lg">
  <div class="flex w-full h-full items-center">
    <div class="flex flex-col justify-between gap-4">
      <div class="flex flex-col h-full">
        <h6 class="text-sm font-light m-0 text-darkslate-300">welcome</h6>

        <p class="sr-only">
          Hi, I'm {SITE.author.fullName}, a high school student in Brookline, MA
          researching fairness and alignment in AI. I study how safety guards
          and reward models treat different groups of people, and I've presented
          that work at NeurIPS, EMNLP, and the UN Institute for Disarmament
          Research. Outside the lab, I run the Brookline Robotics Initiative,
          founded my school's Fintech Club, and co-captain the math team. I'm
          interested in economics, AI policy, and getting more girls into STEM
          and finance.
        </p>
        <p aria-hidden="true" class="m-0 font-light text-base">
          <span>
            Hi, I'm <b class="font-bold">{SITE.author.fullName}</b>, a high
            school student in Brookline, MA researching fairness and alignment
            in AI.
          </span>
          <br />
          <span class="block mt-2">
            I study how safety guards and reward models treat different groups
            of people, and I've presented that work at NeurIPS, EMNLP, and the
            UN Institute for Disarmament Research.
          </span>
          <span class="block mt-2">
            Outside the lab, I run the Brookline Robotics Initiative, founded my
            school's Fintech Club, and co-captain the math team.
          </span>
          <span class="block mt-2">
            I'm interested in economics, AI policy, and getting more girls into
            STEM and finance.
          </span>
        </p>
      </div>
      <div class="flex flex-col lg:flex-row gap-2 lg:gap-4">
        <div class="flex gap-2 lg:gap-4">
          <a href={`mailto:${SITE.links.email}`} aria-label="email">
            <Button aria-label="email">
              <span class="text-sm px-1">Email</span>
            </Button>
          </a>
          <a
            href={SITE.links.linkedin}
            aria-label="linkedin profile"
            target="_blank"
          >
            <Button aria-label="linkedin profile">
              <Icon name="pixel-linkedin" />
              <span class="sr-only" data-umami-event="linkedin button"
                >Linkedin Profile</span
              >
            </Button>
          </a>
          <a
            href={SITE.links.github}
            aria-label="github profile"
            target="_blank"
          >
            <Button aria-label="github profile">
              <Icon name="pixel-github" />
              <span class="sr-only">GitHub Profile</span>
            </Button>
          </a>
          <Tooltip client:visible>
            <Button aria-label="easter egg btn">
              <Icon name="pixel-laugh" />
              <span class="sr-only" data-umami-event="Easter egg button"
                >Easter egg button</span
              >
            </Button>
          </Tooltip>
        </div>
      </div>
    </div>
    <div
      id="memoji-spin-area"
      class="contents md:flex md:flex-col md:items-center md:pb-3 md:select-none md:touch-pan-y md:cursor-[var(--cursor-rotate)]"
    >
      <NeuralOrb
        size="270px"
        label="A rotating network of connected nodes with signals moving between them"
        class="select-none absolute right-[-90px] bottom-[-20px] z-[-1] opacity-50 md:opacity-100 md:relative md:right-auto md:bottom-auto md:z-auto pointer-events-none md:pointer-events-auto"
      />
      <Icon
        name="pixel-rotate"
        aria-hidden="true"
        class="hidden md:block w-[26px] h-auto mt-4 text-darkslate-300 opacity-40"
      />
    </div>
  </div>
</Card>
