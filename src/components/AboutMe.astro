---
import Card from "./Card/index.astro";
import { skills as stack } from "../data/cv";

const CHIP =
  "text-2xs px-2 py-0.5 rounded-full border border-darkslate-400 text-darkslate-100 hover:border-primary-500 hover:text-white transition-colors duration-150";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-6"
  title="Skills & interests"
  class="pad-lg"
>
  <div class="flex flex-col gap-3">
    {
      stack.map(({ group, items }) => (
        <div class="flex flex-col gap-1.5">
          <span class="text-3xs uppercase tracking-wider text-darkslate-300">
            {group}
          </span>
          <div class="flex flex-wrap gap-1.5">
            {items.map((label) => (
              <span class={CHIP}>{label}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Card>
