---
import Globe from "../components/Globe";
import BackLink from "../components/BackLink.astro";
import BasicLayout from "../layouts/BasicLayout.astro";
import { SITE } from "../site-config";

export const prerender = true;
---

<BasicLayout
  description="Countries where I've presented research"
  page="travel"
  title={`${SITE.author.fullName} - Where I've presented`}
>
  <BackLink href="/" class="absolute top-4 left-4" />

  <Globe client:load enableHover={true} />
</BasicLayout>
